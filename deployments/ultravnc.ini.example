[admin]
SocketConnect=1
AllowLoopback=1
LoopbackOnly=1
UseIpv6=0
HTTPConnect=0
AuthRequired=1
MSLogonRequired=0
AutoPortSelect=0
PortNumber=5900
FileTransferEnabled=0
InputsEnabled=1
RemoveWallpaper=0

