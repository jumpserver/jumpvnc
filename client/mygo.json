{
  "name": "SuperVNC",
  "slug": "sshvnc-desktop",
  "identifier": "com.sshvnc.desktop",
  "version": "0.1.0",
  "icon": "resources/icon.png",
  "frontendDist": "dist",
  "buildCommand": "npm --prefix frontend run build",
  "out": "build",
  "bindings": "frontend/generated.ts",
  "fileAssociations": [
    {
      "ext": ["svnc"],
      "name": "SuperVNC Connection",
      "mimeType": "application/x-svnc",
      "role": "Viewer"
    }
  ],
  "resources": ["frontend/node_modules/@novnc/novnc/LICENSE.txt"]
}
